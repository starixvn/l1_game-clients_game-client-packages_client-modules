{
  "name": "@nex3/client-modules",
  "version": "1.0.11",
  "files": [
    "build/"
  ],
  "main": "./build/modules.js",
  "types": "./build/modules.d.ts",
  "scripts": {
    "test": "jest",
    "test-coverage": "jest --coverage",
    "build": "rimraf ./build && tsc && rollup -c && rimraf build/umd && yarn dts",
    "dts": "dts-bundle-generator -o build/modules.d.ts lib/modules.ts --umd-module-name modules --export-referenced-types --no-banner --inline-declare-global",
    "reg": "npm set registry http://npm.lumigame.com",
    "semantic-release": "semantic-release",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:beta": "npm version prerelease --preid beta",
    "publish": "npm publish --registry http://npm.lumigame.com",
    "publish-beta": "npm publish --registry http://npm.lumigame.com --tag beta"
  },
  "devDependencies": {
    "@babel/core": "^7.16.7",
    "@babel/plugin-transform-object-assign": "^7.16.7",
    "@babel/preset-env": "^7.16.8",
    "@commitlint/cli": "^9.1.2",
    "@commitlint/config-conventional": "^9.1.2",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@semantic-release/changelog": "^5.0.1",
    "@semantic-release/commit-analyzer": "^8.0.1",
    "@semantic-release/git": "^9.0.0",
    "@semantic-release/gitlab": "^6.0.4",
    "@semantic-release/npm": "^7.0.5",
    "@semantic-release/release-notes-generator": "^9.0.1",
    "@types/jest": "^27.4.0",
    "@types/socket.io-client": "^3.0.0",
    "dts-bundle-generator": "^6.4.0",
    "husky": "^4.2.5",
    "jest": "^27.4.7",
    "jest-extended": "^1.2.0",
    "jest-junit": "^13.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.63.0",
    "rollup-plugin-terser": "^7.0.2",
    "sc-semantic-release": "^1.2.0",
    "semantic-release": "^17.2.1",
    "ts-jest": "^27.1.2",
    "typescript": "^4.1.3"
  },
  "dependencies": {
    "@nex3/user-client": "^1.8.2",
    "mobx": "^6.3.12",
    "mobx-cocos": "^1.1.4",
    "socket.io-client": "2.4.0"
  },
  "husky": {
    "hooks": {
      "pre-push": "yarn build && yarn test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "extends": [
      "sc-semantic-release"
    ]
  }
}
